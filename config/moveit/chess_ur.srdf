<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur">
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group_state name="ready" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-0.24"/>
    <joint name="shoulder_lift_joint" value="-1.43"/>
    <joint name="elbow_joint" value="1.75"/>
    <joint name="wrist_1_joint" value="-1.89"/>
    <joint name="wrist_2_joint" value="-1.57"/>
    <joint name="wrist_3_joint" value="-1.82"/>
  </group_state>
  <end_effector name="gripper" parent_link="tool0" group="ur_manipulator"/>

  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>
  <!-- gripper: everything on the hand touches everything else on the hand -->
  <disable_collisions link1="gripper_base" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="finger_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="finger_right" reason="Adjacent"/>
  <disable_collisions link1="finger_left" link2="finger_right" reason="Never"/>
  <disable_collisions link1="finger_left" link2="tool0" reason="Never"/>
  <disable_collisions link1="finger_right" link2="tool0" reason="Never"/>
  <disable_collisions link1="finger_left" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="finger_right" link2="wrist_3_link" reason="Never"/>
</robot>
